// https://github.com/DavidAnson/markdownlint-cli2
{
    "config": {
        "default": true,
        // Long lines are fine in prose and tables
        "MD013": false,
        // Same heading allowed under different parents (e.g. "Linux" in two sections)
        "MD024": { "siblings_only": true },
        // Inline HTML is allowed (badges, details blocks)
        "MD033": false
    },
    "ignores": ["node_modules/**", "vendor/**", "var/**", ".tools/cache/**"]
}
