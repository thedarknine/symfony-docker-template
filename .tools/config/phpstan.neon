# https://phpstan.org/config-reference
# Relative paths are resolved from this file's directory
parameters:
    level: 6
    paths:
        - ../../bin/
        - ../../config/
        - ../../public/
        - ../../src/
        - ../../tests/
    excludePaths:
        # Generated by Symfony, rewritten at each cache warmup
        - ../../config/reference.php
    tmpDir: ../cache/phpstan

    symfony:
        # Lets PHPStan know the services, parameters and their types (task quality:phpstan warms it up)
        containerXmlPath: ../../var/cache/dev/App_KernelDevDebugContainer.xml
