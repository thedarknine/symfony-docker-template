# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> Define projet ###
PROJECT_NAME="MyProject"
# Lowercase, no spaces: prefixes the container, network and volume names (project-app, project-db...)
PROJECT_SLUG=project
TIMEZONE=Europe/Paris
ENCODING=utf-8
ENVIRONMENT=dev
###< Define projet ###

###> Docker Compose files ###
# Read by "docker compose" (and the tasks): dev services are added on top of the base file.
# In production, set COMPOSE_FILE=docker-compose.yaml in the server environment.
COMPOSE_FILE=docker-compose.yaml:docker-compose.dev.yaml
# Host ports: change them to run several projects from this template side by side
APP_PORT=8000
DB_PORT=3306
ADM_PORT=8089
# On Linux, set your own ids in .env.local so the app container can write in the project
# (run "id -u" and "id -g"), then rebuild the image: task docker:build.
# Not needed with Docker Desktop (macOS, Windows).
# HOST_UID=1000
# HOST_GID=1000
###< Docker Compose files ###

###> Versions for docker containers ###
PHP_VERSION=8.4
MYSQL_VERSION=9.7
NGINX_VERSION=1.30
###< Versions for docker containers ###

###> Credentials for docker containers ###
DB_ROOT_PASS=admin
DB_NAME=project
DB_USER=project
DB_PASS=ChangeMe
###< Credentials for docker containers ###

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###


###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# Built from the credentials above: "db" is the MySQL service of docker-compose.dev.yaml (dev only).
# In production, set DATABASE_URL in the server environment.
DATABASE_URL="mysql://${DB_USER}:${DB_PASS}@db:3306/${DB_NAME}?serverVersion=${MYSQL_VERSION}&charset=utf8mb4"
###< doctrine/doctrine-bundle ###
